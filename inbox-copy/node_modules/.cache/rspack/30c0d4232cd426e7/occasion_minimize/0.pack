api/index.js{"version":3,"sources":["api/index.js"],"sourcesContent":["class InboxApiHandler {\n    ctx;\n    constructor(ctx){\n        this.ctx = ctx;\n    }\n    async handle(request) {\n        const route = request.path.join(\"/\");\n        if (request.method === \"GET\" && request.path.length === 0) {\n            return Response.json({\n                appId: this.ctx.app.id,\n                version: this.ctx.app.version,\n                status: \"ok\"\n            });\n        }\n        // GET inbox?windowHours=720&threadId=... ‚Äî reads the Rome mailbox, grouped\n        // into threads. Shaping lives in the mailbox_read_copy action so the agent and\n        // this UI share one code path.\n        if (request.method === \"GET\" && route === \"inbox\") {\n            const rawWindow = request.query.get(\"windowHours\");\n            const windowHours = rawWindow ? Number(rawWindow) : undefined;\n            const threadId = request.query.get(\"threadId\") ?? undefined;\n            const result = await this.ctx.runAction(\"mailbox_read_copy\", {\n                ...Number.isFinite(windowHours) ? {\n                    windowHours\n                } : {},\n                ...threadId ? {\n                    threadId\n                } : {}\n            });\n            if (result.status !== \"ok\") {\n                const error = result.status === \"error\" ? result.error : `mailbox_read_copy returned ${result.status}`;\n                return Response.json({\n                    error\n                }, {\n                    status: 502\n                });\n            }\n            return Response.json(result.data);\n        }\n        return Response.json({\n            error: \"not_found\",\n            appId: this.ctx.app.id,\n            message: `Unknown inbox API route: /${route}`\n        }, {\n            status: 404\n        });\n    }\n}\nfunction createApiHandler(ctx) {\n    return new InboxApiHandler(ctx);\n}\n\nexport { createApiHandler };\n"],"names":["InboxApiHandler","ctx","request","route","Response","rawWindow","windowHours","Number","threadId","result","error","createApiHandler"],"mappings":"AAAA,MAAMA;IACF,IAAI;IACJ,YAAYC,GAAG,CAAC;QACZ,IAAI,CAAC,GAAG,GAAGA;IACf;IACA,MAAM,OAAOC,OAAO,EAAE;QAClB,MAAMC,QAAQD,QAAQ,IAAI,CAAC,IAAI,CAAC;QAChC,IAAIA,AAAmB,UAAnBA,QAAQ,MAAM,IAAcA,AAAwB,MAAxBA,QAAQ,IAAI,CAAC,MAAM,EAC/C,OAAOE,SAAS,IAAI,CAAC;YACjB,OAAO,IAAI,CAAC,GAAG,CAAC,GAAG,CAAC,EAAE;YACtB,SAAS,IAAI,CAAC,GAAG,CAAC,GAAG,CAAC,OAAO;YAC7B,QAAQ;QACZ;QAKJ,IAAIF,AAAmB,UAAnBA,QAAQ,MAAM,IAAcC,AAAU,YAAVA,OAAmB;YAC/C,MAAME,YAAYH,QAAQ,KAAK,CAAC,GAAG,CAAC;YACpC,MAAMI,cAAcD,YAAYE,OAAOF,aAAa;YACpD,MAAMG,WAAWN,QAAQ,KAAK,CAAC,GAAG,CAAC,eAAe;YAClD,MAAMO,SAAS,MAAM,IAAI,CAAC,GAAG,CAAC,SAAS,CAAC,qBAAqB;gBACzD,GAAGF,OAAO,QAAQ,CAACD,eAAe;oBAC9BA;gBACJ,IAAI,CAAC,CAAC;gBACN,GAAGE,WAAW;oBACVA;gBACJ,IAAI,CAAC,CAAC;YACV;YACA,IAAIC,AAAkB,SAAlBA,OAAO,MAAM,EAAW;gBACxB,MAAMC,QAAQD,AAAkB,YAAlBA,OAAO,MAAM,GAAeA,OAAO,KAAK,GAAG,CAAC,2BAA2B,EAAEA,OAAO,MAAM,EAAE;gBACtG,OAAOL,SAAS,IAAI,CAAC;oBACjBM;gBACJ,GAAG;oBACC,QAAQ;gBACZ;YACJ;YACA,OAAON,SAAS,IAAI,CAACK,OAAO,IAAI;QACpC;QACA,OAAOL,SAAS,IAAI,CAAC;YACjB,OAAO;YACP,OAAO,IAAI,CAAC,GAAG,CAAC,GAAG,CAAC,EAAE;YACtB,SAAS,CAAC,0BAA0B,EAAED,OAAO;QACjD,GAAG;YACC,QAAQ;QACZ;IACJ;AACJ;AACA,SAASQ,iBAAiBV,GAAG;IACzB,OAAO,IAAID,gBAAgBC;AAC/B;SAESU,gBAAgB"}{"version":3,"sources":["/home/rome/.rome/default/projects/apps/inbox-copy/src/api/index.ts"],"sourcesContent":["import type { RomeAppApiHandler, RomeAppApiRequest, RomeAppContext } from \"@rome-os/app-runtime\";\n\nclass InboxApiHandler implements RomeAppApiHandler {\n  constructor(private readonly ctx: RomeAppContext) {}\n\n  async handle(request: RomeAppApiRequest): Promise<Response> {\n    const route = request.path.join(\"/\");\n\n    if (request.method === \"GET\" && request.path.length === 0) {\n      return Response.json({ appId: this.ctx.app.id, version: this.ctx.app.version, status: \"ok\" });\n    }\n\n    // GET inbox?windowHours=720&threadId=... ‚Äî reads the Rome mailbox, grouped\n    // into threads. Shaping lives in the mailbox_read_copy action so the agent and\n    // this UI share one code path.\n    if (request.method === \"GET\" && route === \"inbox\") {\n      const rawWindow = request.query.get(\"windowHours\");\n      const windowHours = rawWindow ? Number(rawWindow) : undefined;\n      const threadId = request.query.get(\"threadId\") ?? undefined;\n\n      const result = await this.ctx.runAction(\"mailbox_read_copy\", {\n        ...(Number.isFinite(windowHours) ? { windowHours } : {}),\n        ...(threadId ? { threadId } : {}),\n      });\n\n      if (result.status !== \"ok\") {\n        const error =\n          result.status === \"error\" ? result.error : `mailbox_read_copy returned ${result.status}`;\n        return Response.json({ error }, { status: 502 });\n      }\n      return Response.json(result.data);\n    }\n\n    return Response.json(\n      {\n        error: \"not_found\",\n        appId: this.ctx.app.id,\n        message: `Unknown inbox API route: /${route}`,\n      },\n      { status: 404 },\n    );\n  }\n}\n\nexport function createApiHandler(ctx: RomeAppContext): RomeAppApiHandler {\n  return new InboxApiHandler(ctx);\n}\n"],"names":["InboxApiHandler","ctx","request","route","Response","rawWindow","windowHours","Number","undefined","threadId","result","error","createApiHandler"],"mappings":"AAEA,MAAMA,eAAeA;;IACnB,YAA6BC,GAAmB,CAAE;aAArBA,MAAAA;IAAsB;IAEnD,MAAM,OAAOC,OAA0B,EAAqB;QAC1D,MAAMC,QAAQD,QAAQ,IAAI,CAAC,IAAI,CAAC;QAEhC,IAAIA,QAAQ,MAAM,KAAK,SAASA,QAAQ,IAAI,CAAC,MAAM,KAAK,GAAG;YACzD,OAAOE,SAAS,IAAI,CAAC;gBAAE,OAAO,IAAI,CAAC,GAAG,CAAC,GAAG,CAAC,EAAE;gBAAE,SAAS,IAAI,CAAC,GAAG,CAAC,GAAG,CAAC,OAAO;gBAAE,QAAQ;YAAK;QAC7F;QAEA,2EAA2E;QAC3E,+EAA+E;QAC/E,+BAA+B;QAC/B,IAAIF,QAAQ,MAAM,KAAK,SAASC,UAAU,SAAS;YACjD,MAAME,YAAYH,QAAQ,KAAK,CAAC,GAAG,CAAC;YACpC,MAAMI,cAAcD,YAAYE,OAAOF,aAAaG;YACpD,MAAMC,WAAWP,QAAQ,KAAK,CAAC,GAAG,CAAC,eAAeM;YAElD,MAAME,SAAS,MAAM,IAAI,CAAC,GAAG,CAAC,SAAS