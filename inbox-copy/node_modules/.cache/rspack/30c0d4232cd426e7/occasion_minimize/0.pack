e∂;øclass InboxApiHandler {
    ctx;
    constructor(ctx){
        this.ctx = ctx;
    }
    async handle(request) {
        const route = request.path.join("/");
        if ("GET" === request.method && 0 === request.path.length) return Response.json({
            appId: this.ctx.app.id,
            version: this.ctx.app.version,
            status: "ok"
        });
