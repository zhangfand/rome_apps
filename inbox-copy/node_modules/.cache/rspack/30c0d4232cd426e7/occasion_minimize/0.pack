∆˛MÖ¨œ~øimport { createAppLogger } from "@rome-os/app-runtime";
const log = createAppLogger("mailbox_read_copy");
const DEFAULT_WINDOW_HOURS = 720;
function isChannelUnavailable(error) {
    const e = error.toLowerCase();
    return e.includes("not configured") || e.includes("not running") || e.includes("does not support");
}
function firstLine(text, max = 140) {
    const line = text.replace(/\s+/g, " ").trim();
    return line.length > max ? `${line.slice(0, max - 1)}‚Ä¶` : line;
}
function groupIntoThreads(messages) {
    const byThread = new Map();
    const subjectByThread = new Map();
    for (const m of messages){
        let bucket = byThread.get(m.threadId);
        if (!bucket) {
            bucket = [];
            byThread.set(m.threadId, bucket);
        }
        bucket.push({
            id: m.id,
            from: m.displayName,
            receivedAt: m.timestamp,
            body: m.text,
            attachments: m.attachments ?? []
        });
        if (!subjectByThread.get(m.threadId) && m.threadName?.trim()) subjectByThread.set(m.threadId, m.threadName.trim());
    }
    const threads = [];
    for (const [threadId, msgs] of byThread){
        msgs.sort((a, b)=>a.receivedAt.localeCompare(b.receivedAt));
        const latest = msgs[msgs.length - 1];
        threads.push({
            threadId,
            subject: subjectByThread.get(threadId) ?? "(no subject)",
            from: latest.from,
            lastReceivedAt: latest.receivedAt,
            messageCount: msgs.length,
            hasAttachments: msgs.some((m)=>m.attachments.length > 0),
            preview: firstLine(latest.body),
            messages: msgs
        });
    }
    threads.sort((a, b)=>b.lastReceivedAt.localeCompare(a.lastReceivedAt));
    return threads;
}
function createAction(config, deps) {
    const { appContext } = deps;
    return {
        config,
        inputSchema: {
            type: "object",
            properties: {
                windowHours: {
                    type: "number",
                    description: "How many hours back to read (default: 720 = 30 days)."
                },
                threadId: {
                    type: "string",
                    description: "Optional: restrict to a single conversation thread id."
                }
            },
            required: []
        },
        async execute (args) {
            const windowHours = args.windowHours ?? DEFAULT_WINDOW_HOURS;
            const threadId = args.threadId;
            const result = await appContext.runAction("fetch_channel_history", {
                channel: "email",
                windowHours,
                threadId,
                includeMessages: true
            });
            if ("ok" !== result.status) {
                const error = "error" === result.status ? result.error : `returned ${result.status}`;
                if (isChannelUnavailable(error)) {
                    log.info("email channel unavailable; returning empty mailbox", {
                        error
                    });
                    const empty = {
                        available: false,
                        windowHours,
                        threads: []
                    };
                    return {
                        status: "ok",
                        data: empty
                    };
                }
                return {
                    status: "error",
                    error: `Could not read mailbox: ${error}`
                };
            }
            const messages = (result.data?.messages ?? []).filter((m)=>Boolean(m && m.threadId && m.id));
            const data = {
                available: true,
                windowHours,
                threads: groupIntoThreads(messages)
            };
            log.info("mailbox read", {
                threads: data.threads.length,
                windowHours
            });
            return {
                status: "ok",
                data
            };
        }
    };
}
export { createAction, groupIntoThreads };
actions/mailbox-read-copy/index.js{"version":3,"sources":["actions/mailbox-read-copy/index.js"],"sourcesContent":["import { createAppLogger } from \"@rome-os/app-runtime\";\n\n\n\nconst log = createAppLogger(\"mailbox_read_copy\");\n/** 30 days ‚Äî the default read window. The Rome mailbox is low-volume, and\n *  `fetch_channel_history` caps how much it hydrates, so a generous default is\n *  safe and spares the user from paging for recent mail. */ const DEFAULT_WINDOW_HOURS = 24 * 30;\n/** The `fetch_channel_history` error text emitted when the email channel is\n *  absent. Treated as \"no mailbox yet\", not a failure. */ function isChannelUnavailable(error) {\n    const e = error.toLowerCase();\n    return e.includes(\"not configured\") || e.includes(\"not running\") || e.includes(\"does not support\");\n}\nfunction firstLine(text, max = 140) {\n    const line = text.replace(/\\s+/g, \" \").trim();\n    return line.length > max ? `${line.slice(0, max - 1)}‚Ä¶` : line;\n}\n/** Group a flat, oldest-first message list into threads, newest thread first.\n *  Pure ‚Äî unit-tested directly. */ function groupIntoThreads(messages) {\n    const byThread = new Map();\n    const subjectByThread = new Map();\n    for (const m of messages){\n        let bucket = byThread.get(m.threadId);\n        if (!bucket) {\n            bucket = [];\n            byThread.set(m.threadId, bucket);\n        }\n        bucket.push({\n            id: m.id,\n            from: m.displayName,\n            receivedAt: m.timestamp,\n            body: m.text,\n            attachments: m.attachments ?? []\n        });\n        // The first non-empty threadName we see for a thread is its subject.\n        if (!subjectByThread.get(m.threadId) && m.threadName?.trim()) {\n            subjectByThread.set(m.threadId, m.threadName.trim());\n        }\n    }\n    const threads = [];\n    for (const [threadId, msgs] of byThread){\n        msgs.sort((a, b)=>a.receivedAt.localeCompare(b.receivedAt));\n        const latest = msgs[msgs.length - 1];\n        threads.push({\n            threadId,\n            subject: subjectByThread.get(threadId) ?? \"(no subject)\",\n            from: latest.from,\n            lastReceivedAt: latest.receivedAt,\n            messageCount: msgs.length,\n            hasAttachments: msgs.some((m)=>m.attachments.length > 0),\n            preview: firstLine(latest.body),\n            messages: msgs\n        });\n    }\n    // Newest conversation first.\n    threads.sort((a, b)=>b.lastReceivedAt.localeCompare(a.lastReceivedAt));\n    return threads;\n}\nfunction createAction(config, deps) {\n    const { appContext } = deps;\n    return {\n        config,\n        inputSchema: {\n            type: \"object\",\n            properties: {\n                windowHours: {\n                    type: \"number\",\n                    description: \"How many hours back to read (default: 720 = 30 days).\"\n                },\n                threadId: {\n                    type: \"string\",\n                    description: \"Optional: restrict to a single conversation thread id.\"\n                }\n            },\n            required: []\n        },\n        async execute (args) {\n            const windowHours = args.windowHours ?? DEFAULT_WINDOW_HOURS;\n            const threadId = args.threadId;\n            const result = await appContext.runAction(\"fetch_channel_history\", {\n                channel: \"email\",\n                windowHours,\n                threadId,\n                includeMessages: true\n            });\n            if (result.status !== \"ok\") {\n                const error = result.status === \"error\" ? result.error : `returned ${result.status}`;\n                if (isChannelUnavailable(error)) {\n                    log.info(\"email channel unavailable; returning empty mailbox\", {\n                        error\n                    });\n                    const empty = {\n                        available: false,\n                        windowHours,\n                        threads: []\n                    };\n                    return {\n                        status: \"ok\",\n                        data: empty\n                    };\n                }\n                return {\n                    status: \"error\",\n                    error: `Could not read mailbox: ${error}`\n                };\n            }\n            const messages = (result.data?.messages ?? []).filter((m)=>Boolean(m && m.threadId && m.id));\n            const data = {\n                available: true,\n                windowHours,\n                threads: groupIntoThreads(messages)\n            };\n            log.info(\"mailbox read\", {\n                threads: data.threads.length,\n                windowHours\n            });\n            return {\n                status: \"ok\",\n                data\n            };\n        }\n    };\n}\n\nexport { createAction, groupIntoThreads };\n"],"names":["createAppLogger","log","DEFAULT_WINDOW_HOURS","isChannelUnavailable","error","e","firstLine","text","max","line","groupIntoThreads","messages","byThread","Map","subjectByThread","m","bucket","threads","threadId","msgs","a","b","latest","createAction","config","deps","appContext","args","windowHours","result","empty","Boolean","data"],"mappings":"AAAA,SAASA,eAAe,QAAQ,uBAAuB;AAIvD,MAAMC,MAAMD,gBAAgB;AAGiC,MAAME,uBAAuB;AAE/B,SAASC,qBAAqBC,KAAK;IAC1F,MAAMC,IAAID,MAAM,WAAW;IAC3B,OAAOC,EAAE,QAAQ,CAAC,qBAAqBA,EAAE,QAAQ,CAAC,kBAAkBA,EAAE,QAAQ,CAAC;AACnF;AACA,SAASC,UAAUC,IAAI,EAAEC,MAAM,GAAG;IAC9B,MAAMC,OAAOF,KAAK,OAAO,CAAC,QAAQ,KAAK,IAAI;IAC3C,OAAOE,KAAK,MAAM,GAAGD,MAAM,GAAGC,KAAK,KAAK,CAAC,GAAGD,MAAM,GAAG,CAAC,CAAC,GAAGC;AAC9D;AAEoC,SAASC,iBAAiBC,QAAQ;IAClE,MAAMC,WAAW,IAAIC;IACrB,MAAMC,kBAAkB,IAAID;IAC5B,KAAK,MAAME,KAAKJ,SAAS;QACrB,IAAIK,SAASJ,SAAS,GAAG,CAACG,EAAE,QAAQ;QACpC,IAAI,CAACC,QAAQ;YACTA,SAAS,EAAE;YACXJ,SAAS,GAAG,CAACG,EAAE,QAAQ,EAAEC;QAC7B;QACAA,OAAO,IAAI,CAAC;YACR,IAAID,EAAE,EAAE;YACR,MAAMA,EAAE,WAAW;YACnB,YAAYA,EAAE,SAAS;YACvB,MAAMA,EAAE,IAAI;YACZ,aAAaA,EAAE,WAAW,IAAI,EAAE;QACpC;QAEA,IAAI,CAACD,gBAAgB,GAAG,CAACC,EAAE,QAAQ,KAAKA,EAAE,UAAU,EAAE,QAClDD,gBAAgB,GAAG,CAACC,EAAE,QAAQ,EAAEA,EAAE,UAAU,CAAC,IAAI;IAEzD;IACA,MAAME,UAAU,EAAE;IAClB,KAAK,MAAM,CAACC,UAAUC,KAAK,IAAIP,SAAS;QACpCO,KAAK,IAAI,CAAC,CAACC,GAAGC,IAAID,EAAE,UAAU,CAAC,aAAa,CAACC,EAAE,UAAU;QACzD,MAAMC,SAASH,IAAI,CAACA,KAAK,MAAM,GAAG,EAAE;QACpCF,QAAQ,IAAI,CAAC;YACTC;YACA,SAASJ,gBAAgB,GAAG,CAACI,aAAa;YAC1C,MAAMI,OAAO,IAAI;YACjB,gBAAgBA,OAAO,UAAU;YACjC,cAAcH,KAAK,MAAM;YACzB,gBAAgBA,KAAK,IAAI,CAAC,CAACJ,IAAIA,EAAE,WAAW,CAAC,MAAM,GAAG;YACtD,SAAST,UAAUgB,OAAO,IAAI;YAC9B,UAAUH;QACd;IACJ;IAEAF,QAAQ,IAAI,CAAC,CAACG,GAAGC,IAAIA,EAAE,cAAc,CAAC,aAAa,CAACD,EAAE,cAAc;IACpE,OAAOH;AACX;AACA,SAASM,aAAaC,MAAM,EAAEC,IAAI;IAC9B,MAAM,EAAEC,UAAU,EAAE,GAAGD;IACvB,OAAO;QACHD;QACA,aAAa;YACT,MAAM;YACN,YAAY;gBACR,aAAa;oBACT,MAAM;oBACN,aAAa;gBACjB;gBACA,UAAU;oBACN,MAAM;oBACN,aAAa;gBACjB;YACJ;YACA,UAAU,EAAE;QAChB;QACA,MAAM,SAASG,IAAI;YACf,MAAMC,cAAcD,KAAK,WAAW,IAAIzB;YACxC,MAAMgB,WAAWS,KAAK,QAAQ;YAC9B,MAAME,SAAS,MAAMH,WAAW,SAAS,CAAC,yBAAyB;gBAC/D,SAAS;gBACTE;gBACAV;gBACA,iBAAiB;YACrB;YACA,IAAIW,AAAkB,SAAlBA,OAAO,MAAM,EAAW;gBACxB,MAAMzB,QAAQyB,AAAkB,YAAlBA,OAAO,MAAM,GAAeA,OAAO,KAAK,GAAG,CAAC,SAAS,EAAEA,OAAO,MAAM,EAAE;gBACpF,IAAI1B,qBAAqBC,QAAQ;oBAC7BH,IAAI,IAAI,CAAC,sDAAsD;wBAC3DG;oBACJ;oBACA,MAAM0B,QAAQ;wBACV,WAAW;wBACXF;wBACA,SAAS,EAAE;oBACf;oBACA,OAAO;wBACH,QAAQ;wBACR,MAAME;oBACV;gBACJ;gBACA,OAAO;oBACH,QAAQ;oBACR,OAAO,CAAC,wBAAwB,EAAE1B,OAAO;gBAC7C;YACJ;YACA,MAAMO,WAAW,AAACkB,CAAAA,OAAO,IAAI,EAAE,YAAY,EAAE,AAAD,EAAG,MAAM,CAAC,CAACd,IAAIgB,QAAQhB,KAAKA,EAAE,QAAQ,IAAIA,EAAE,EAAE;YAC1F,MAAMiB,OAAO;gBACT,WAAW;gBACXJ;gBACA,SAASlB,iBAAiBC;YAC9B;YACAV,IAAI,IAAI,CAAC,gBAAgB;gBACrB,SAAS+B,KAAK,OAAO,CAAC,MAAM;gBAC5BJ;YACJ;YACA,OAAO;gBACH,QAAQ;gBACRI;YACJ;QACJ;IACJ;AACJ;SAEST,YAAY,EAAEb,gBAAgB"}{"version":3,"sources":["/home/rome/.rome/default/projects/apps/inbox-copy/src/actions/mailbox-read-copy/index.ts"],"sourcesContent":["import {\n  createAppLogger,\n  type Action,\n  type ActionConfig,\n  type ActionResult,\n  type AppActionRuntimeDeps,\n} from \"@rome-os/app-runtime\";\n\nconst log = createAppLogger(\"mailbox_read_copy\");\n\n/** 30 days ‚Äî the default read window. The Rome mailbox is low-volume, and\n *  `fetch_channel_history` caps how much it hydrates, so a generous default is\n *  safe and spares the user from paging for recent mail. */\nconst DEFAULT_WINDOW_HOURS = 24 * 30;\n\n/** The subset of a `fetch_channel_history` structured message this app consumes.\n *  Kept local so the app owns exactly the shape it renders, tolerant of extra\n *  fields the system action may add. */\ninterface HistoryAttachment {\n  type: string;\n  url?: string;\n  mimeType?: string;\n  fileName?: string;\n  caption?: string;\n}\n\ninterface HistoryMessage {\n  id: string;\n  displayName: string;\n  timestamp: string;\n  threadId: string;\n  threadName?: string;\n  text: string;\n  attachments: HistoryAttachment[];\n}\n\nexport interface MailMessage {\n  id: string;\n  from: string;\n  receivedAt: string;\n  body: string;\n  attachments: HistoryAttachment[];\n}\n\nexport interface MailThread {\n  threadId: string;\n  subject: string;\n  /** Sender of the most recent message in the thread. */\n  from: string;\n  lastReceivedAt: string;\n  messageCount: number;\n  hasAttachments: boolean;\n  /** First line of the latest message, truncated for the list view. */\n  preview: string;\n  messages: MailMessage[];\n}\n\nexport interface MailboxReadData {\n  /** False when no Rome mailbox is provisioned / the email channel is not\n   *  running ‚Äî the UI shows an onboarding state instead of an error. */\n  available: boolean;\n  windowHours: number;\n  threads: MailThread[];\n}\n\n/** The `fetch_channel_history` error text emitted when the email channel is\n *  absent. Treated as \"no mailbox yet\", not a failure. */\nfunction isChannelUnavailable(error: string): boolean {\n  const e = error.toLowerCase();\n  return (\n    e.includes(\"not configured\") || e.includes(\"not running\") || e.includes(\"does not support\")\n  );\n}\n\nfunction firstLine(text: string, max = 140): string {\n  const line = text.replace(/\\s+/g, \" \").trim();\n  return line.length > max ? `${line.slice(0, max - 1)}‚Ä¶` : line;\n}\n\n/** Group a flat, oldest-first message list into threads, newest thread first.\n *  Pure ‚Äî unit-tested directly. */\nexport function groupIntoThreads(messages: HistoryMessage[]): MailThread[] {\n  const byThread = new Map<string, MailMessage[]>();\n  const subjectByThread = new Map<string, string>();\n\n  for (const m of messages) {\n    let bucket = byThread.get(m.threadId);\n    if (!bucket) {\n      bucket = [];\n      byThread.set(m.threadId, bucket);\n    }\n    bucket.push({\n      id: m.id,\n      from: m.displayName,\n      receivedAt: m.timestamp,\n      body: m.text,\n      attachments: m.attachments ?? [],\n    });\n    // The first non-empty threadName we see for a thread is its subject.\n    if (!subjectByThread.get(m.threadId) && m.threadName?.trim()) {\n      subjectByThread.set(m.threadId, m.threadName.trim());\n    }\n  }\n\n  const threads: MailThread[] = [];\n  for (const [threadId, msgs] of byThread) {\n    msgs.sort((a, b) => a.receivedAt.localeCompare(b.receivedAt));\n    const latest = msgs[msgs.length - 1];\n    threads.push({\n      threadId,\n      subject: subjectByThread.get(threadId) ?? \"(no subject)\",\n      from: latest.from,\n      lastReceivedAt: latest.receivedAt,\n      messageCount: msgs.length,\n      hasAttachments: msgs.some((m) => m.attachments.length > 0),\n      preview: firstLine(latest.body),\n      messages: msgs,\n    });\n  }\n\n  // Newest conversation first.\n  threads.sort((a, b) => b.lastReceivedAt.localeCompare(a.lastReceivedAt));\n  return threads;\n}\n\nexport function createAction(config: ActionConfig, deps: AppActionRuntimeDeps): Action {\n  const { appContext } = deps;\n\n  return {\n    config,\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        windowHours: {\n          type: \"number\",\n          description: \"How many hours back to read (default: 720 = 30 days).\",\n        },\n        threadId: {\n          type: \"string\",\n          description: \"Optional: restrict to a single conversation thread id.\",\n        },\n      },\n      required: [],\n    },\n\n    async execute(args): Promise<ActionResult> {\n      const windowHours = (args.windowHours as number | undefined) ?? DEFAULT_WINDOW_HOURS;\n      const threadId = args.threadId as string | undefined;\n\n      const result = await appContext.runAction(\"fetch_channel_history\", {\n        channel: \"email\",\n        windowHours,\n        threadId,\n        includeMessages: true,\n      });\n\n      if (result.status !== \"ok\") {\n        const error = result.status === \"error\" ? result.error : `returned ${result.status}`;\n        if (isChannelUnavailable(error)) {\n          log.info(\"email channel unavailable; returning empty mailbox\", { error });\n          const empty: MailboxReadData = { available: false, windowHours, threads: [] };\n          return { status: \"ok\", data: empty };\n        }\n        return { status: \"error\", error: `Could not read mailbox: ${error}` };\n      }\n\n      const messages = ((result.data as { messages?: HistoryMessage[] })?.messages ?? []).filter(\n        (m): m is HistoryMessage => Boolean(m && m.threadId && m.id),\n      );\n\n      const data: MailboxReadData = {\n        available: true,\n        windowHours,\n        threads: groupIntoThreads(messages),\n      };\n      log.info(\"mailbox read\", { threads: data.threads.length, windowHours });\n      return { status: \"ok\", data };\n    },\n  };\n}\n"],"names":["createAppLogger","log","DEFAULT_WINDOW_HOURS","isChannelUnavailable","error","e","firstLine","text","max","line","groupIntoThreads","messages","byThread","Map","subjectByThread","m","bucket","threads","threadId","msgs","a","