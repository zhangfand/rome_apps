111, 0, 0, 0.525],\n    \"923\": [0, 0.61111, 0, 0, 0.525],\n    \"926\": [0, 0.61111, 0, 0, 0.525],\n    \"928\": [0, 0.61111, 0, 0, 0.525],\n    \"931\": [0, 0.61111, 0, 0, 0.525],\n    \"933\": [0, 0.61111, 0, 0, 0.525],\n    \"934\": [0, 0.61111, 0, 0, 0.525],\n    \"936\": [0, 0.61111, 0, 0, 0.525],\n    \"937\": [0, 0.61111, 0, 0, 0.525],\n    \"8216\": [0, 0.61111, 0, 0, 0.525],\n    \"8217\": [0, 0.61111, 0, 0, 0.525],\n    \"8242\": [0, 0.61111, 0, 0, 0.525],\n    \"9251\": [0.11111, 0.21944, 0, 0, 0.525]\n  }\n};\n\n/**\n * This file contains metrics regarding fonts and individual symbols. The sigma\n * and xi variables, as well as the metricMap map contain data extracted from\n * TeX, TeX font metrics, and the TTF files. These data are then exposed via the\n * `metrics` variable and the getCharacterMetrics function.\n */\n// In TeX, there are actually three sets of dimensions, one for each of\n// textstyle (size index 5 and higher: >=9pt), scriptstyle (size index 3 and 4:\n// 7-8pt), and scriptscriptstyle (size index 1 and 2: 5-6pt).  These are\n// provided in the arrays below, in that order.\n//\n// The font metrics are stored in fonts cmsy10, cmsy7, and cmsy5 respectively.\n// This was determined by running the following script:\n//\n//     latex -interaction=nonstopmode \\\n//     '\\documentclass{article}\\usepackage{amsmath}\\begin{document}' \\\n//     '$a$ \\expandafter\\show\\the\\textfont2' \\\n//     '\\expandafter\\show\\the\\scriptfont2' \\\n//     '\\expandafter\\show\\the\\scriptscriptfont2' \\\n//     '\\stop'\n//\n// The metrics themselves were retrieved using the following commands:\n//\n//     tftopl cmsy10\n//     tftopl cmsy7\n//     tftopl cmsy5\n//\n// The output of each of these commands is quite lengthy.  The only part we\n// care about is the FONTDIMEN section. Each value is measured in EMs.\nvar sigmasAndXis = {\n  slant: [0.250, 0.250, 0.250],\n  // sigma1\n  space: [0.000, 0.000, 0.000],\n  // sigma2\n  stretch: [0.000, 0.000, 0.000],\n  // sigma3\n  shrink: [0.000, 0.000, 0.000],\n  // sigma4\n  xHeight: [0.431, 0.431, 0.431],\n  // sigma5\n  quad: [1.000, 1.171, 1.472],\n  // sigma6\n  extraSpace: [0.000, 0.000, 0.000],\n  // sigma7\n  num1: [0.677, 0.732, 0.925],\n  // sigma8\n  num2: [0.394, 0.384, 0.387],\n  // sigma9\n  num3: [0.444, 0.471, 0.504],\n  // sigma10\n  denom1: [0.686, 0.752, 1.025],\n  // sigma11\n  denom2: [0.345, 0.344, 0.532],\n  // sigma12\n  sup1: [0.413, 0.503, 0.504],\n  // sigma13\n  sup2: [0.363, 0.431, 0.404],\n  // sigma14\n  sup3: [0.289, 0.286, 0.294],\n  // sigma15\n  sub1: [0.150, 0.143, 0.200],\n  // sigma16\n  sub2: [0.247, 0.286, 0.400],\n  // sigma17\n  supDrop: [0.386, 0.353, 0.494],\n  // sigma18\n  subDrop: [0.050, 0.071, 0.100],\n  // sigma19\n  delim1: [2.390, 1.700, 1.980],\n  // sigma20\n  delim2: [1.010, 1.157, 1.420],\n  // sigma21\n  axisHeight: [0.250, 0.250, 0.250],\n  // sigma22\n  // These font metrics are extracted from TeX by using tftopl on cmex10.tfm;\n  // they correspond to the font parameters of the extension fonts (family 3).\n  // See the TeXbook, page 441. In AMSTeX, the extension fonts scale; to\n  // match cmex7, we'd use cmex7.tfm values for script and scriptscript\n  // values.\n  defaultRuleThickness: [0.04, 0.049, 0.049],\n  // xi8; cmex7: 0.049\n  bigOpSpacing1: [0.111, 0.111, 0.111],\n  // xi9\n  bigOpSpacing2: [0.166, 0.166, 0.166],\n  // xi10\n  bigOpSpacing3: [0.2, 0.2, 0.2],\n  // xi11\n  bigOpSpacing4: [0.6, 0.611, 0.611],\n  // xi12; cmex7: 0.611\n  bigOpSpacing5: [0.1, 0.143, 0.143],\n  // xi13; cmex7: 0.143\n  // The \\sqrt rule width is taken from the height of the surd character.\n  // Since we use the same font at all sizes, this thickness doesn't scale.\n  sqrtRuleThickness: [0.04, 0.04, 0.04],\n  // This value determines how large a pt is, for metrics which are defined\n  // in terms of pts.\n  // This value is also used in katex.scss; if you change it make sure the\n  // values match.\n  ptPerEm: [10.0, 10.0, 10.0],\n  // The space between adjacent `|` columns in an array definition. From\n  // `\\showthe\\doublerulesep` in LaTeX. Equals 2.0 / ptPerEm.\n  doubleRuleSep: [0.2, 0.2, 0.2],\n  // The width of separator lines in {array} environments. From\n  // `\\showthe\\arrayrulewidth` in LaTeX. Equals 0.4 / ptPerEm.\n  arrayRuleWidth: [0.04, 0.04, 0.04],\n  // Two values from LaTeX source2e:\n  fboxsep: [0.3, 0.3, 0.3],\n  //        3 pt / ptPerEm\n  fboxrule: [0.04, 0.04, 0.04] // 0.4 pt / ptPerEm\n};\n// These are very rough approximations.  We default to Times New Roman which\n// should have Latin-1 and Cyrillic characters, but may not depending on the\n// operating system.  The metrics do not account for extra height from the\n// accents.  In the case of Cyrillic characters which have both ascenders and\n// descenders we prefer approximations with ascenders, primarily to prevent\n// the fraction bar or root line from intersecting the glyph.\n// TODO(kevinb) allow union of multiple glyph metrics for better accuracy.\nvar extraCharacterMap = {\n  // Latin-1\n  'Å': 'A',\n  'Ð': 'D',\n  'Þ': 'o',\n  'å': 'a',\n  'ð': 'd',\n  'þ': 'o',\n  // Cyrillic\n  'А': 'A',\n  'Б': 'B',\n  'В': 'B',\n  'Г': 'F',\n  'Д': 'A',\n  'Е': 'E',\n  'Ж': 'K',\n  'З': '3',\n  'И': 'N',\n  'Й': 'N',\n  'К': 'K',\n  'Л': 'N',\n  'М': 'M',\n  'Н': 'H',\n  'О': 'O',\n  'П': 'N',\n  'Р': 'P',\n  'С': 'C',\n  'Т': 'T',\n  'У': 'y',\n  'Ф': 'O',\n  'Х': 'X',\n  'Ц': 'U',\n  'Ч': 'h',\n  'Ш': 'W',\n  'Щ': 'W',\n  'Ъ': 'B',\n  'Ы': 'X',\n  'Ь': 'B',\n  'Э': '3',\n  'Ю': 'X',\n  'Я': 'R',\n  'а': 'a',\n  'б': 'b',\n  'в': 'a',\n  'г': 'r',\n  'д': 'y',\n  'е': 'e',\n  'ж': 'm',\n  'з': 'e',\n  'и': 'n',\n  'й': 'n',\n  'к': 'n',\n  'л': 'n',\n  'м': 'm',\n  'н': 'n',\n  'о': 'o',\n  'п': 'n',\n  'р': 'p',\n  'с': 'c',\n  'т': 'o',\n  'у': 'y',\n  'ф': 'b',\n  'х': 'x',\n  'ц': 'n',\n  'ч': 'n',\n  'ш': 'w',\n  'щ': 'w',\n  'ъ': 'a',\n  'ы': 'm',\n  'ь': 'a',\n  'э': 'e',\n  'ю': 'm',\n  'я': 'r'\n};\n/**\n * This function adds new font metrics to default metricMap\n * It can also override existing metrics\n */\nfunction setFontMetrics(fontName, metrics) {\n  fontMetricsData[fontName] = metrics;\n}\n/**\n * This function is a convenience function for looking up information in the\n * metricMap table. It takes a character as a string, and a font.\n *\n * Note: the `width` property may be undefined if fontMetricsData.js wasn't\n * built using `Make extended_metrics`.\n */\nfunction getCharacterMetrics(character, font, mode) {\n  if (!fontMetricsData[font]) {\n    throw new Error(\"Font metrics not found for font: \" + font + \".\");\n  }\n  var ch = character.charCodeAt(0);\n  var metrics = fontMetricsData[font][ch];\n  if (!metrics && character[0] in extraCharacterMap) {\n    ch = extraCharacterMap[character[0]].charCodeAt(0);\n    metrics = fontMetricsData[font][ch];\n  }\n  if (!metrics && mode === 'text') {\n    // We don't typically have font metrics for Asian scripts.\n    // But since we support them in text mode, we need to return\n    // some sort of metrics.\n    // So if the character is in a script we support but we\n    // don't have metrics for it, just use the metrics for\n    // the Latin capital letter M. This is close enough because\n    // we (currently) only care about the height of the glyph\n    // not its width.\n    if (supportedCodepoint(ch)) {\n      metrics = fontMetricsData[font][77]; // 77 is the charcode for 'M'\n    }\n  }\n  if (metrics) {\n    return {\n      depth: metrics[0],\n      height: metrics[1],\n      italic: metrics[2],\n      skew: metrics[3],\n      width: metrics[4]\n    };\n  }\n}\nvar fontMetricsBySizeIndex = {};\n/**\n * Get the font metrics for a given size.\n */\nfunction getGlobalMetrics(size) {\n  var sizeIndex;\n  if (size >= 5) {\n    sizeIndex = 0;\n  } else if (size >= 3) {\n    sizeIndex = 1;\n  } else {\n    sizeIndex = 2;\n  }\n  if (!fontMetricsBySizeIndex[sizeIndex]) {\n    var metrics = fontMetricsBySizeIndex[sizeIndex] = {\n      cssEmPerMu: sigmasAndXis.quad[sizeIndex] / 18\n    };\n    for (var key in sigmasAndXis) {\n      if (sigmasAndXis.hasOwnProperty(key)) {\n        metrics[key] = sigmasAndXis[key][sizeIndex];\n      }\n    }\n  }\n  return fontMetricsBySizeIndex[sizeIndex];\n}\n\n/**\n * This file holds a list of all no-argument functions and single-character\n * symbols (like 'a' or ';').\n *\n * For each of the symbols, there are three properties they can have:\n * - font (required): the font to be used for this symbol. Either \"main\" (the\n     normal font), or \"ams\" (the ams fonts).\n * - group (required): the ParseNode group type the symbol should have (i.e.\n     \"textord\", \"mathord\", etc).\n     See https://github.com/KaTeX/KaTeX/wiki/Examining-TeX#group-types\n * - replace: the character that this symbol or function should be\n *   replaced with (i.e. \"\\phi\" has a replace value of \"\\u03d5\", the phi\n *   character in the main font).\n *\n * The outermost map in the table indicates what mode the symbols should be\n * accepted in (e.g. \"math\" or \"text\").\n */\nvar symbols = {\n  \"math\": {},\n  \"text\": {}\n};\n/** `acceptUnicodeChar = true` is only applicable if `replace` is set. */\nfunction defineSymbol(mode, font, group, replace, name, acceptUnicodeChar) {\n  symbols[mode][name] = {\n    font,\n    group,\n    replace\n  };\n  if (acceptUnicodeChar && replace) {\n    symbols[mode][replace] = symbols[mode][name];\n  }\n}\n// Some abbreviations for commonly used strings.\n// This helps minify the code, and also spotting typos using jshint.\n// modes:\nvar katex_math = \"math\";\nvar katex_text = \"text\";\n// fonts:\nvar katex_main = \"main\";\nvar ams = \"ams\";\n// groups:\nvar katex_accent = \"accent-token\";\nvar bin = \"bin\";\nvar katex_close = \"close\";\nvar katex_inner = \"inner\";\nvar mathord = \"mathord\";\nvar op = \"op-token\";\nvar katex_open = \"open\";\nvar punct = \"punct\";\nvar rel = \"rel\";\nvar katex_spacing = \"spacing\";\nvar katex_textord = \"textord\";\n// Now comes the symbol table\n// Relation Symbols\ndefineSymbol(katex_math, katex_main, rel, \"\\u2261\", \"\\\\equiv\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u227a\", \"\\\\prec\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u227b\", \"\\\\succ\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u223c\", \"\\\\sim\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u22a5\", \"\\\\perp\");\ndefineSymbol(katex_math, katex_main, rel, \"\\u2aaf\", \"\\\\preceq\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u2ab0\", \"\\\\succeq\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u2243\", \"\\\\simeq\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u2223\", \"\\\\mid\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u226a\", \"\\\\ll\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u226b\", \"\\\\gg\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u224d\", \"\\\\asymp\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u2225\", \"\\\\parallel\");\ndefineSymbol(katex_math, katex_main, rel, \"\\u22c8\", \"\\\\bowtie\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u2323\", \"\\\\smile\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u2291\", \"\\\\sqsubseteq\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u2292\", \"\\\\sqsupseteq\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u2250\", \"\\\\doteq\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u2322\", \"\\\\frown\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u220b\", \"\\\\ni\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u221d\", \"\\\\propto\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u22a2\", \"\\\\vdash\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u22a3\", \"\\\\dashv\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u220b\", \"\\\\owns\");\n// Punctuation\ndefineSymbol(katex_math, katex_main, punct, \"\\u002e\", \"\\\\ldotp\");\ndefineSymbol(katex_math, katex_main, punct, \"\\u22c5\", \"\\\\cdotp\");\n// The KaTeX fonts do not contain U+00B7. Use the centered dot glyph at U+22C5\n// in both modes, but keep math-mode punctuation spacing only in math mode.\ndefineSymbol(katex_math, katex_main, punct, \"\\u22c5\", \"\\u00b7\");\ndefineSymbol(katex_text, katex_main, katex_textord, \"\\u22c5\", \"\\u00b7\");\n// Misc Symbols\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u0023\", \"\\\\#\");\ndefineSymbol(katex_text, katex_main, katex_textord, \"\\u0023\", \"\\\\#\");\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u0026\", \"\\\\&\");\ndefineSymbol(katex_text, katex_main, katex_textord, \"\\u0026\", \"\\\\&\");\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u2135\", \"\\\\aleph\", true);\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u2200\", \"\\\\forall\", true);\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u210f\", \"\\\\hbar\", true);\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u2203\", \"\\\\exists\", true);\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u2207\", \"\\\\nabla\", true);\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u266d\", \"\\\\flat\", true);\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u2113\", \"\\\\ell\", true);\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u266e\", \"\\\\natural\", true);\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u2663\", \"\\\\clubsuit\", true);\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u2118\", \"\\\\wp\", true);\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u266f\", \"\\\\sharp\", true);\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u2662\", \"\\\\diamondsuit\", true);\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u211c\", \"\\\\Re\", true);\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u2661\", \"\\\\heartsuit\", true);\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u2111\", \"\\\\Im\", true);\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u2660\", \"\\\\spadesuit\", true);\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u00a7\", \"\\\\S\", true);\ndefineSymbol(katex_text, katex_main, katex_textord, \"\\u00a7\", \"\\\\S\");\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u00b6\", \"\\\\P\", true);\ndefineSymbol(katex_text, katex_main, katex_textord, \"\\u00b6\", \"\\\\P\");\n// Math and Text\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u2020\", \"\\\\dag\");\ndefineSymbol(katex_text, katex_main, katex_textord, \"\\u2020\", \"\\\\dag\");\ndefineSymbol(katex_text, katex_main, katex_textord, \"\\u2020\", \"\\\\textdagger\");\ndefineSymbol(katex_math, katex_main, katex_textord, \"\\u2021\", \"\\\\ddag\");\ndefineSymbol(katex_text, katex_main, katex_textord, \"\\u2021\", \"\\\\ddag\");\ndefineSymbol(katex_text, katex_main, katex_textord, \"\\u2021\", \"\\\\textdaggerdbl\");\n// Large Delimiters\ndefineSymbol(katex_math, katex_main, katex_close, \"\\u23b1\", \"\\\\rmoustache\", true);\ndefineSymbol(katex_math, katex_main, katex_open, \"\\u23b0\", \"\\\\lmoustache\", true);\ndefineSymbol(katex_math, katex_main, katex_close, \"\\u27ef\", \"\\\\rgroup\", true);\ndefineSymbol(katex_math, katex_main, katex_open, \"\\u27ee\", \"\\\\lgroup\", true);\n// Binary Operators\ndefineSymbol(katex_math, katex_main, bin, \"\\u2213\", \"\\\\mp\", true);\ndefineSymbol(katex_math, katex_main, bin, \"\\u2296\", \"\\\\ominus\", true);\ndefineSymbol(katex_math, katex_main, bin, \"\\u228e\", \"\\\\uplus\", true);\ndefineSymbol(katex_math, katex_main, bin, \"\\u2293\", \"\\\\sqcap\", true);\ndefineSymbol(katex_math, katex_main, bin, \"\\u2217\", \"\\\\ast\");\ndefineSymbol(katex_math, katex_main, bin, \"\\u2294\", \"\\\\sqcup\", true);\ndefineSymbol(katex_math, katex_main, bin, \"\\u25ef\", \"\\\\bigcirc\", true);\ndefineSymbol(katex_math, katex_main, bin, \"\\u2219\", \"\\\\bullet\", true);\ndefineSymbol(katex_math, katex_main, bin, \"\\u2021\", \"\\\\ddagger\");\ndefineSymbol(katex_math, katex_main, bin, \"\\u2240\", \"\\\\wr\", true);\ndefineSymbol(katex_math, katex_main, bin, \"\\u2a3f\", \"\\\\amalg\");\ndefineSymbol(katex_math, katex_main, bin, \"\\u0026\", \"\\\\And\"); // from amsmath\n// Arrow Symbols\ndefineSymbol(katex_math, katex_main, rel, \"\\u27f5\", \"\\\\longleftarrow\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u21d0\", \"\\\\Leftarrow\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u27f8\", \"\\\\Longleftarrow\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u27f6\", \"\\\\longrightarrow\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u21d2\", \"\\\\Rightarrow\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u27f9\", \"\\\\Longrightarrow\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u2194\", \"\\\\leftrightarrow\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u27f7\", \"\\\\longleftrightarrow\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u21d4\", \"\\\\Leftrightarrow\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u27fa\", \"\\\\Longleftrightarrow\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u21a6\", \"\\\\mapsto\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u27fc\", \"\\\\longmapsto\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u2197\", \"\\\\nearrow\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u21a9\", \"\\\\hookleftarrow\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u21aa\", \"\\\\hookrightarrow\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u2198\", \"\\\\searrow\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u21bc\", \"\\\\leftharpoonup\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u21c0\", \"\\\\rightharpoonup\", true);\ndefineSymbol(katex_math, katex_main, rel, \"\\u2199\", \"\\\\swarrow\", true);\ndefineSymbol(katex_math,