\": [\n      \"tf\",\n      \"tfvars\"\n    ],\n    \"import\": (() => import(\"__RSPACK_ESM_CHUNK_4838\"))\n  },\n  {\n    \"id\": \"tex\",\n    \"name\": \"TeX\",\n    \"import\": (() => import(\"__RSPACK_ESM_CHUNK_6407\"))\n  },\n  {\n    \"id\": \"toml\",\n    \"name\": \"TOML\",\n    \"import\": (() => import(\"__RSPACK_ESM_CHUNK_5876\"))\n  },\n  {\n    \"id\": \"ts-tags\",\n    \"name\": \"TypeScript with Tags\",\n    \"aliases\": [\n      \"lit\"\n    ],\n    \"import\": (() => import(\"__RSPACK_ESM_CHUNK_7331\").then(m => m.ts_tags_namespaceObject))\n  },\n  {\n    \"id\": \"tsv\",\n    \"name\": \"TSV\",\n    \"import\": (() => import(\"__RSPACK_ESM_CHUNK_6235\"))\n  },\n  {\n    \"id\": \"tsx\",\n    \"name\": \"TSX\",\n    \"import\": (() => import(\"__RSPACK_ESM_CHUNK_7681\"))\n  },\n  {\n    \"id\": \"turtle\",\n    \"name\": \"Turtle\",\n    \"import\": (() => import(\"__RSPACK_ESM_CHUNK_2014\"))\n  },\n  {\n    \"id\": \"twig\",\n    \"name\": \"Twig\",\n    \"import\": (() => import(\"__RSPACK_ESM_CHUNK_4465\"))\n  },\n  {\n    \"id\": \"typescript\",\n    \"name\": \"TypeScript\",\n    \"aliases\": [\n      \"ts\",\n      \"cts\",\n      \"mts\"\n    ],\n    \"import\": (() => import(\"__RSPACK_ESM_CHUNK_6683\"))\n  },\n  {\n    \"id\": \"typespec\",\n    \"name\": \"TypeSpec\",\n    \"aliases\": [\n      \"tsp\"\n    ],\n    \"import\": (() => import(\"__RSPACK_ESM_CHUNK_7327\"))\n  },\n  {\n    \"id\": \"typst\",\n    \"name\": \"Typst\",\n    \"aliases\": [\n      \"typ\"\n    ],\n    \"import\": (() => import(\"__RSPACK_ESM_CHUNK_6076\"))\n  },\n  {\n    \"id\": \"v\",\n    \"name\": \"V\",\n    \"import\": (() => import(\"__RSPACK_ESM_CHUNK_4312\"))\n  },\n  {\n    \"id\": \"vala\",\n    \"name\": \"Vala\",\n    \"import\": (() => import(\"__RSPACK_ESM_CHUNK_4646\"))\n  },\n  {\n    \"id\": \"vb\",\n    \"name\": \"Visual Basic\",\n    \"aliases\": [\n      \"cmd\"\n    ],\n    \"import\": (() => import(\"__RSPACK_ESM_CHUNK_2912\"))\n  },\n  {