0.0.1:9223\";\n\nconst researchSchema = z.object({\n  operation: z.enum([\"search\", \"profile\", \"tweets\"]),\n  query: z.string().trim().optional().describe(\"Search query when operation is search\"),\n  username: z.string().trim().optional().describe(\"X username when operation is profile or tweets\"),\n  limit: z.number().int().min(1).max(50).optional(),\n});\n\nasync function runOpenCli(args: string[]): Promise<unknown> {\n  const { stdout } = await execFileAsync(\n    \"opencli\",\n    [\n      \"--cdp-endpoint\",\n      CDP_ENDPOINT,\n      \"twitter\",\n      ...args,\n      \"-f\",\n      \"json\",\n      \"--window\",\n      \"background\",\n      \"--site-session\",\n      \"persistent\",\n      \"--keep-tab\",\n      \"false\",\n    ],\n    { timeout: 90_000, maxBuffer: 6 * 1024 * 1024 },\n  );\n  return JSON.parse(stdout);\n}\n\nexport function createAction(config: ActionConfig, _deps: AppActionRuntimeDeps): Action {\n  return defineAction({\n    config,\n    schema: researchSchema,\n    execute: async ({ operation, query, username, limit = 15 }) => {\n      try {\n        let args: string[];\n        if (operation === \"search\") {\n          if (!query) return { status: \"error\", error: \"query is required for search\" };\n          args = [\"search\", query, \"--limit\", String(limit), \"--product\", \"live\", \"--exclude\", \"retweets\"];\n        } else if (operation === \"profile\") {\n          if (!username) return { status: \"error\", error: \"username is required for profile\" };\n          args = [\"profile\", username.replace(/^@/, \"\")];\n        } else {\n          if (!username) return { status: \"error\", error: \"username is required for tweets\" };\n          args = [\n            \"tweets\",\n            username.replace(/^@/, \"\"),\n            \"--limit\",\n            String(limit),\n            \"--page-delay\",\n            \"1\",\n          ];\n        }\n        const data = await runOpenCli(args);\n        return { status: \"ok\", data };\n      } catch (error) {\n        const message = error instanceof Error ? error.message : String(error);\n        log.error(\"X research failed\", { operation, error: message });\n        return { status: \"error\", error: message };\n      }\n    },\n  });\n}\n"],"names":["execFile","promisify","createAppLogger","defineAction","z","execFileAsync","log","CDP_ENDPOINT","researchSchema","runOpenCli","args","stdout","JSON","createAction","config","_deps","operation","query","username","limit","String","data","error","message","Error"],"mappings":";;;;;;;AAA8C;AACR;AAQR;AAE9B,MAAMK,aAAaA,GAAGJ,SAASA,CAACD,QAAQA;AACxC,MAAMM,GAAGA,GAAGJ,eAAeA,CAAC;AAC5B,MAAMK,YAAYA,GAAG;AAErB,MAAMC,cAAcA,GAAGJ,QAAQ,CAAC;IAC9B,WAAWA,SAAM,CAAC;QAAC;QAAU;QAAW;KAAS;IACjD,OAAOA,QAAQ,GAAG,IAAI,GAAG,QAAQ,GAAG,QAAQ,CAAC;IAC7C,UAAUA,QAAQ,GAAG,IAAI,GAAG,QAAQ,GAAG,QAAQ,CAAC;IAChD,OAAOA,QAAQ,GAAG,GAAG,GAAG,GAAG,CAAC,GAAG,GAAG,CAAC,IAAI,QAAQ;AACjD;AAEA,eAAeK,UAAUA,CAACC,IAAc;IACtC,MAAM,EAAEC,MAAM,EAAE,GAAG,MAAMN,aAAaA,CACpC,WACA;QACE;QACAE,YAAYA;QACZ;WACGG;QACH;QACA;QACA;QACA;QACA;QACA;QACA;QACA;KACD,EACD;QAAE,SAAS;QAAQ,WAAW,IAAI,OAAO;IAAK;IAEhD,OAAOE,KAAK,KAAK,CAACD;AACpB;AAEO,SAASE,YAAYA,CAACC,MAAoB,EAAEC,KAA2B;IAC5E,OAAOZ,YAAYA,CAAC;QAClBW;QACA,QAAQN,cAAcA;QACtB,SAAS,OAAO,EAAEQ,SAAS,EAAEC,KAAK,EAAEC,QAAQ,EAAEC,QAAQ,EAAE,EAAE;YACxD,IAAI;gBACF,IAAIT;gBACJ,IAAIM,cAAc,UAAU;oBAC1B,IAAI,CAACC,OAAO,OAAO;wBAAE,QAAQ;wBAAS,OAAO;oBAA+B;oBAC5EP,OAAO;wBAAC;wBAAUO;wBAAO;wBAAWG,OAAOD;wBAAQ;wBAAa;wBAAQ;wBAAa;qBAAW;gBAClG,OAAO,IAAIH,cAAc,WAAW;oBAClC,IAAI,CAACE,UAAU,OAAO;wBAAE,QAAQ;wBAAS,OAAO;oBAAmC;oBACnFR,OAAO;wBAAC;wBAAWQ,SAAS,OAAO,CAAC,MAAM;qBAAI;gBAChD,OAAO;oBACL,IAAI,CAACA,UAAU,OAAO;wBAAE,QAAQ;wBAAS,OAAO;oBAAkC;oBAClFR,OAAO;wBACL;wBACAQ,SAAS,OAAO,CAAC,MAAM;wBACvB;wBACAE,OAAOD;wBACP;wBACA;qBACD;gBACH;gBACA,MAAME,OAAO,MAAMZ,UAAUA,CAACC;gBAC9B,OAAO;oBAAE,QAAQ;oBAAMW;gBAAK;YAC9B,EAAE,OAAOC,OAAO;gBACd,MAAMC,UAAUD,iBAAiBE,QAAQF,MAAM,OAAO,GAAGF,OAAOE;gBAChEhB,GAAGA,CAAC,KAAK,CAAC,qBAAqB;oBAAEU;oBAAW,OAAOO;gBAAQ;gBAC3D,OAAO;oBAAE,QAAQ;oBAAS,OAAOA;gBAAQ;YAC3C;QACF;IACF;AACF"}␀␀␀␀␀␀Ö4␀␀òÀˇˇõ␀␀␀ïÿˇˇçU␀␀®ÿˇˇ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀¥G␀␀›Ìˇˇ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀8 5520
‹÷ïl¨wimport { desc } from "drizzle-orm";
import { createAppDbSchema } from "../schema.js";
class PlansRepository {
    db;
    tables;
    constructor(db, tablePrefix){
        this.db = db;
        this.tables = createAppDbSchema(tablePrefix);
    }
    async save(input) {
        const row = {
            id: crypto.randomUUID(),
            title: input.title,
            markdown: input.markdown,
            performanceSummary: input.performanceSummary ?? null,
            focus: input.focus ?? null,
            createdAt: new Date()
        };
        this.db.insert(this.tables.plans).values(row).run();
        return row;
    }
    async list(limit = 12) {
        return this.db.select().from(this.tables.plans).orderBy(desc(this.tables.plans.createdAt)).limit(limit).all();
    }
}
function createPlansRepository(ctx) {
    return new PlansRepository(ctx.connection, ctx.tablePrefix);
}
export { PlansRepository, createPlansRepository };
db/repositories/plans.js{"version":3,"sources":["db/repositories/plans.js"],"sourcesContent":["import { desc } from \"drizzle-orm\";\nimport { createAppDbSchema } from \"../schema.js\";\n\n\n\n\n\nclass PlansRepository {\n    db;\n    tables;\n    constructor(db, tablePrefix){\n        this.db = db;\n        this.tables = createAppDbSchema(tablePrefix);\n    }\n    async save(input) {\n        const row = {\n            id: crypto.randomUUID(),\n            title: input.title,\n            markdown: input.markdown,\n            performanceSummary: input.performanceSummary ?? null,\n            focus: input.focus ?? null,\n            createdAt: new Date()\n        };\n        this.db.insert(this.tables.plans).values(row).run();\n        return row;\n    }\n    async list(limit = 12) {\n        return this.db.select().from(this.tables.plans).orderBy(desc(this.tables.plans.createdAt)).limit(limit).all();\n    }\n}\nfunction createPlansRepository(ctx) {\n    return new PlansRepository(ctx.connection, ctx.tablePrefix);\n}\n\nexport { PlansRepository, createPlansRepository };\n"],"names":["desc","createAppDbSchema","PlansRepository","db","tablePrefix","input","row","crypto","Date","limit","createPlansRepository","ctx"],"mappings":"AAAA,SAASA,IAAI,QAAQ,cAAc;AACnC,SAASC,iBAAiB,QAAQ,eAAe;AAMjD,MAAMC;IACF,GAAG;IACH,OAAO;IACP,YAAYC,EAAE,EAAEC,WAAW,CAAC;QACxB,IAAI,CAAC,EAAE,GAAGD;QACV,IAAI,CAAC,MAAM,GAAGF,kBAAkBG;IACpC;IACA,MAAM,KAAKC,KAAK,EAAE;QACd,MAAMC,MAAM;YACR,IAAIC,OAAO,UAAU;YACrB,OAAOF,MAAM,KAAK;YAClB,UAAUA,MAAM,QAAQ;YACxB,oBAAoBA,MAAM,kBAAkB,IAAI;YAChD,OAAOA,MAAM,KAAK,IAAI;YACtB,WAAW,IAAIG;QACnB;QACA,IAAI,CAAC,EAAE,CAAC,MAAM,CAAC,IAAI,CAAC,MAAM,CAAC,KAAK,EAAE,MAAM,CAACF,KAAK,GAAG;QACjD,OAAOA;IACX;IACA,MAAM,KAAKG,QAAQ,EAAE,EAAE;QACnB,OAAO,IAAI,CAAC,EAAE,CAAC,MAAM,GAAG,IAAI,CAAC,IAAI,CAAC,MAAM,CAAC,KAAK,EAAE,OAAO,CAACT,KAAK,IAAI,CAAC,MAAM,CAAC,KAAK,CAAC,SAAS,GAAG,KAAK,CAACS,OAAO,GAAG;IAC/G;AACJ;AACA,SAASC,sBAAsBC,GAAG;IAC9B,OAAO,IAAIT,gBAAgBS,IAAI,UAAU,EAAEA,IAAI,WAAW;AAC9D;SAEST,eAAe,EAAEQ,qBAAqB"}{"version":3,"sources":["/home/rome/.rome/default/projects/apps/account-growth/src/db/repositories/plans.ts"],"sourcesContent":["import { desc } from \"drizzle-orm\";\nimport type { AppDbContext, DrizzleDb } from \"@rome-os/app-runtime\";\nimport { createAppDbSchema } from \"../schema.js\";\n\nexport interface SavedPlan {\n  id: string;\n  title: string;\n  markdown: string;\n  performanceSummary: string | null;\n  focus: string | null;\n  createdAt: Date;\n}\n\nexport class PlansRepository {\n  private readonly tables;\n\n  constructor(\n    private readonly db: DrizzleDb,\n    tablePrefix: string,\n  ) {\n    this.tables = createAppDbSchema(tablePrefix);\n  }\n\n  async save(input: {\n    title: string;\n    markdown: string;\n    performanceSummary?: string;\n    focus?: string;\n  }): Promise<SavedPlan> {\n    const row: SavedPlan = {\n      id: crypto.randomUUID(),\n      title: input.title,\n      markdown: input.markdown,\n      performanceSummary: input.performanceSummary ?? null,\n      focus: input.focus ?? null,\n      createdAt: new Date(),\n    };\n    this.db.insert(this.tables.plans).values(row).run();\n    return row;\n  }\n\n  async list(limit = 12): Promise<SavedPlan[]> {\n    return this.db\n      .select()\n      .from(this.tables.plans)\n      .orderBy(desc(this.tables.plans.createdAt))\n      .limit(limit)\n      .all();\n  }\n}\n\nexport function createPlansRepository(ctx: AppDbContext): PlansRepository {\n  return new PlansRepository(ctx.connection, ctx.tablePrefix);\n}\n"],"names":["desc","createAppDbSchema","PlansRepository","db","tablePrefix","input","row","crypto","Date","limit","createPlansRepository","ctx"],"mappings":";;;;;AAAmC;AAEc;AAW1C,MAAME,eAAeA;;IACT,OAAO;IAExB,YACmBC,EAAa,EAC9BC,WAAmB,CACnB;aAFiBD,KAAAA;QAGjB,IAAI,CAAC,MAAM,GAAGF,iBAAiBA,CAACG;IAClC;IAEA,MAAM,KAAKC,KAKV,EAAsB;QACrB,MAAMC,MAAiB;YACrB,IAAIC,OAAO,UAAU;YACrB,OAAOF,MAAM,KAAK;YAClB,UAAUA,MAAM,QAAQ;YACxB,oBAAoBA,MAAM,kBAAkB,IAAI;YAChD,OAAOA,MAAM,KAAK,IAAI;YACtB,WAAW,IAAIG;QACjB;QACA,IAAI,CAAC,EAAE,CAAC,MAAM,CAAC,IAAI,CAAC,MAAM,CAAC,KAAK,EAAE,MAAM,CAACF,KAAK,GAAG;QACjD,OAAOA;IACT;IAEA,MAAM,KAAKG,QAAQ,EAAE,EAAwB;QAC3C,OAAO,IAAI,CAAC,EAAE,CACX,MAAM,GACN,IAAI,CAAC,IAAI,CAAC,MAAM,CAAC,KAAK,EACtB,OAAO,CAACT,IAAIA,CAAC,IAAI,CAAC,MAAM,CAAC,KAAK,CAAC,SAAS,GACxC,KAAK,CAACS,OACN,GAAG;IACR;AACF;AAEO,SAASC,qBAAqBA,CAACC,GAAiB;IACrD,OAAO,IAAIT,eAAeA,CAACS,IAAI,UAAU,EAAEA,IAAI,WAAW;AAC5D"}␀␀␀␀␀␀µ␀␀ËÍˇˇò␀␀␀ïÓˇˇï␀␀•Óˇˇ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Ø%␀␀bˆˇˇ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀8 4332
}Gú–fimport { defineAction, z } from "@rome-os/app-runtime";
import { createPlansRepository } from "../../db/repositories/plans.js";
const savePlanSchema = z.object({
    title: z.string().trim().min(1).max(160),
    markdown: z.string().trim().min(200).describe("Complete weekly plan in Markdown"),
    performanceSummary: z.string().trim().max(2000).optional(),
    focus: z.string().trim().max(500).optional()
});
function createAction(config, deps) {
    return defineAction({
        config,
        schema: savePlanSchema,
        execute: async (input)=>{
            const repository = createPlansRepository(deps.appContext.db);
            const saved = await repository.save(input);
            return {
                status: "ok",
                data: saved
            };
        }
    });
}
export { createAction };
actions/save-plan/index.js{"version":3,"sources":["actions/save-plan/index.js"],"sourcesContent":["import { defineAction, z } from \"@rome-os/app-runtime\";\nimport { createPlansRepository } from \"../../db/repositories/plans.js\";\n\n\n\n\n\nconst savePlanSchema = z.object({\n    title: z.string().trim().min(1).max(160),\n    markdown: z.string().trim().min(200).describe(\"Complete weekly plan in Markdown\"),\n    performanceSummary: z.string().trim().max(2000).optional(),\n    focus: z.string().trim().max(500).optional()\n});\nfunction createAction(config, deps) {\n    return defineAction({\n        config,\n        schema: savePlanSchema,\n        execute: async (input)=>{\n            const repository = createPlansRepository(deps.appContext.db);\n            const saved = await repository.save(input);\n            return {\n                status: \"ok\",\n                data: saved\n            };\n        }\n    });\n}\n\nexport { createAction };\n"],"names":["defineAction","z","createPlansRepository","savePlanSchema","createAction","config","deps","input","repository","saved"],"mappings":"AAAA,SAASA,YAAY,EAAEC,CAAC,QAAQ,uBAAuB;AACvD,SAASC,qBAAqB,QAAQ,iCAAiC;AAMvE,MAAMC,iBAAiBF,EAAE,MAAM,CAAC;IAC5B,OAAOA,EAAE,MAAM,GAAG,IAAI,GAAG,GAAG,CAAC,GAAG,GAAG,CAAC;IACpC,UAAUA,EAAE,MAAM,GAAG,IAAI,GAAG,GAAG,CAAC,KAAK,QAAQ,CAAC;IAC9C,oBAAoBA,EAAE,MAAM,GAAG,IAAI,GAAG,GAAG,CAAC,MAAM,QAAQ;IACxD,OAAOA,EAAE,MAAM,GAAG,IAAI,GAAG,GAAG,CAAC,KAAK,QAAQ;AAC9C;AACA,SAASG,aAAaC,MAAM,EAAEC,IAAI;IAC9B,OAAON,aAAa;QAChBK;QACA,QAAQF;QACR,SAAS,OAAOI;YACZ,MAAMC,aAAaN,sBAAsBI,KAAK,UAAU,CAAC,EAAE;YAC3D,MAAMG,QAAQ,MAAMD,WAAW,IAAI,CAACD;YACpC,OAAO;gBACH,QAAQ;gBACR,MAAME;YACV;QACJ;IACJ;AACJ;SAESL,YAAY"}{"version":3,"sources":["/home/rome/.rome/default/projects/apps/account-growth/src/actions/save-plan/index.ts"],"sourcesContent":["import {\n  defineAction,\n  z,\n  type Action,\n  type ActionConfig,\n  type AppActionRuntimeDeps,\n} from \"@rome-os/app-runtime\";\nimport { createPlansRepository } from \"../../db/repositories/plans.js\";\n\nconst savePlanSchema = z.object({\n  title: z.string().trim().min(1).max(160),\n  markdown: z.string().trim().min(200).describe(\"Complete weekly plan in Markdown\"),\n  performanceSummary: z.string().trim().max(2_000).optional(),\n  focus: z.string().trim().max(500).optional(),\n});\n\nexport function createAction(config: ActionConfig, deps: AppActionRuntimeDeps): Action {\n  return defineAction({\n    config,\n    schema: savePlanSchema,\n    execute: async (input) => {\n      const repository = createPlansRepository(deps.appContext.db);\n      const saved = await repository.save(input);\n      return { status: \"ok\", data: saved };\n    },\n  });\n}\n"],"names":["defineAction","z","createPlansRepository","savePlanSchema","createAction","config","deps","input","repository","saved"],"mappings":";;;;;AAM8B;AACyC;AAEvE,MAAMG,cAAcA,GAAGF,QAAQ,CAAC;IAC9B,OAAOA,QAAQ,GAAG,IAAI,GAAG,GAAG,CAAC,GAAG,GAAG,CAAC;IACpC,UAAUA,QAAQ,GAAG,IAAI,GAAG,GAAG,CAAC,KAAK,QAAQ,CAAC;IAC9C,oBAAoBA,QAAQ,GAAG,IAAI,GAAG,GAAG,CAAC,MAAO,QAAQ;IACzD,OAAOA,QAAQ,GAAG,IAAI,GAAG,GAAG,CAAC,KAAK,QAAQ;AAC5C;AAEO,SAASG,YAAYA,CAACC,MAAoB,EAAEC,IAA0B;IAC3E,OAAON,YAAYA,CAAC;QAClBK;QACA,QAAQF,cAAcA;QACtB,SAAS,OAAOI;YACd,MAAMC,aAAaN,qBAAqBA,CAACI,KAAK,UAAU,CAAC,EAAE;YAC3D,MAAMG,QAAQ,MAAMD,WAAW,IAAI,CAACD;YACpC,OAAO;gBAAE,QAAQ;gBAAM,MAAME;YAAM;QACrC;IACF;AACF"}␀␀␀␀␀␀ª␀␀åÔˇˇö␀␀␀øÚˇˇâ␀␀—Úˇˇ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀è␀␀B˘ˇˇ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀8 17964
√8%òûimport { execFile } from "node:child_process";
import { readFile } from "node:fs/promises";
import { promisify } from "node:util";
import { createAppLogger, defineAction, z } from "@rome-os/app-runtime";
const execFileAsync = promisify(execFile);
const log = createAppLogger("account-growth:snapshot");
const CDP_ENDPOINT = "http://127.0.0.1:9223";
const snapshotSchema = z.object({
    xLimit: z.number().int().min(10).max(100).optional().describe("Number of recent X posts to read"),
    linkedInLimit: z.number().int().min(5).max(50).optional().describe("Number of recent LinkedIn posts to read")
});
async function runOpenCli(site, args) {
    const { stdout } = await execFileAsync("opencli", [
        "--cdp-endpoint",
        CDP_ENDPOINT,
        site,
        ...args,
        "-f",
        "json",
        "--window",
        "background",
        "--site-session",
        "persistent",
        "--keep-tab",
        "false"
    ], {
        timeout: 120000,
        maxBuffer: 8388608
    });
    return JSON.parse(stdout);
}
async function readInitialSnapshot() {
    const path = new URL("../../assets/initial-snapshot.json", import.meta.url);
    return JSON.parse(await readFile(path, "utf8"));
}
function createAction(config, _deps) {
    return defineAction({
        config,
        schema: snapshotSchema,
        execute: async ({ xLimit = 50, linkedInLimit = 30 })=>{
            const snapshot = await readInitialSnapshot();
            const freshness = {
                xProfile: "baseline",
                xPosts: "baseline",
                linkedInProfile: "baseline",
                linkedInPosts: "baseline",
                linkedInAnalytics: "baseline"
            };
            const warnings = [];
            async function refresh(key, task) {
                try {
                    snapshot[key] = await task();
                    freshness[key] = "live";
                } catch (error) {
                    const message = error instanceof Error ? error.message : String(error);
                    warnings.push(`${key}: ${message}`);
                    log.warn("using baseline snapshot component", {
                        key,
                        error: message
                    });
                }
            }
            await refresh("xProfile", ()=>runOpenCli("twitter", [
                    "profile",
                    "realYunfanYe"
                ]));
            await refresh("xPosts", ()=>runOpenCli("twitter", [
                    "tweets",
                    "realYunfanYe",
                    "--limit",
                    String(xLimit),
                    "--page-delay",
                    "1"
                ]));
            await refresh("linkedInProfile", ()=>runOpenCli("linkedin", [
                    "profile-read",
                    "--profile-url",
                    "https://www.linkedin.com/in/yunfanye/"
                ]));
            await refresh("linkedInPosts", ()=>runOpenCli("linkedin", [
                    "posts",
                    "--profile-url",
                    "https://www.linkedin.com/in/yunfanye/",
                    "--limit",
                    String(linkedInLimit)
                ]));
            await refresh("linkedInAnalytics", ()=>runOpenCli("linkedin", [
                    "post-analytics",
                    "--profile-url",
                    "https://www.linkedin.com/in/yunfanye/",
                    "--limit",
                    String(linkedInLimit)
                ]));
            const anyLive = Object.values(freshness).some((value)=>"live" === value);
            return {
                status: "ok",
                data: {
                    ...snapshot,
                    capturedAt: anyLive ? new Date().toISOString() : snapshot.capturedAt,
                    freshness,
                    warnings,
                    note: warnings.length > 0 ? "Some live reads were unavailable or rate-limited; baseline values are explicitly marked." : "All account signals were refreshed live."
                }
            };
        }
    });
}
export { createAction };
actions/snapshot/index.js{"version":3,"sources":["actions/snapshot/index.js"],"sourcesContent":["import { execFile } from \"node:child_process\";\nimport { readFile } from \"node:fs/promises\";\nimport { promisify } from \"node:util\";\nimport { createAppLogger, defineAction, z } from \"@rome-os/app-runtime\";\n\n\n\n\n\n\n\n\n\nconst execFileAsync = promisify(execFile);\nconst log = createAppLogger(\"account-growth:snapshot\");\nconst CDP_ENDPOINT = \"http://127.0.0.1:9223\";\nconst snapshotSchema = z.object({\n    xLimit: z.number().int().min(10).max(100).optional().describe(\"Number of recent X posts to read\"),\n    linkedInLimit: z.number().int().min(5).max(50).optional().describe(\"Number of recent LinkedIn posts to read\")\n});\nasync function runOpenCli(site, args) {\n    const { stdout } = await execFileAsync(\"opencli\", [\n        \"--cdp-endpoint\",\n        CDP_ENDPOINT,\n        site,\n        ...args,\n        \"-f\",\n        \"json\",\n        \"--window\",\n        \"background\",\n        \"--site-session\",\n        \"persistent\",\n        \"--keep-tab\",\n        \"false\"\n    ], {\n        timeout: 120000,\n        maxBuffer: 8 * 1024 * 1024\n    });\n    return JSON.parse(stdout);\n}\nasync function readInitialSnapshot() {\n    const path = new URL(\"../../assets/initial-snapshot.json\", import.meta.url);\n    return JSON.parse(await readFile(path, \"utf8\"));\n}\nfunction createAction(config, _deps) {\n    return defineAction({\n        config,\n        schema: snapshotSchema,\n        execute: async ({ xLimit = 50, linkedInLimit = 30 })=>{\n            const snapshot = await readInitialSnapshot();\n            const freshness = {\n                xProfile: \"baseline\",\n                xPosts: \"baseline\",\n                linkedInProfile: \"baseline\",\n                linkedInPosts: \"baseline\",\n                linkedInAnalytics: \"baseline\"\n            };\n            const warnings = [];\n            async function refresh(key, task) {\n                try {\n                    snapshot[key] = await task();\n                    freshness[key] = \"live\";\n                } catch (error) {\n                    const message = error instanceof Error ? error.message : String(error);\n                    warnings.push(`${key}: ${message}`);\n                    log.warn(\"using baseline snapshot component\", {\n                        key,\n                        error: message\n                    });\n                }\n            }\n            await refresh(\"xProfile\", ()=>runOpenCli(\"twitter\", [\n                    \"profile\",\n                    \"realYunfanYe\"\n                ]));\n            await refresh(\"xPosts\", ()=>runOpenCli(\"twitter\", [\n                    \"tweets\",\n                    \"realYunfanYe\",\n                    \"--limit\",\n                    String(xLimit),\n                    \"--page-delay\",\n                    \"1\"\n                ]));\n            await refresh(\"linkedInProfile\", ()=>runOpenCli(\"linkedin\", [\n                    \"profile-read\",\n                    \"--profile-url\",\n                    \"https://www.linkedin.com/in/yunfanye/\"\n                ]));\n            await refresh(\"linkedInPosts\", ()=>runOpenCli(\"linkedin\", [\n                    \"posts\",\n                    \"--profile-url\",\n                    \"https://www.linkedin.com/in/yunfanye/\",\n                    \"--limit\",\n                    String(linkedInLimit)\n                ]));\n            await refresh(\"linkedInAnalytics\", ()=>runOpenCli(\"linkedin\", [\n                    \"post-analytics\",\n                    \"--profile-url\",\n                    \"https://www.linkedin.com/in/yunfanye/\",\n                    \"--limit\",\n                    String(linkedInLimit)\n                ]));\n            const anyLive = Object.values(freshness).some((value)=>value === \"live\");\n            return {\n                status: \"ok\",\n                data: {\n                    ...snapshot,\n                    capturedAt: anyLive ? new Date().toISOString() : snapshot.capturedAt,\n                    freshness,\n                    warnings,\n                    note: warnings.length > 0 ? \"Some live reads were unavailable or rate-limited; baseline values are explicitly marked.\" : \"All account signals were refreshed live.\"\n                }\n            };\n        }\n    });\n}\n\nexport { createAction };\n"],"names":["execFile","readFile","promisify","createAppLogger","defineAction","z","execFileAsync","log","CDP_ENDPOINT","snapshotSchema","runOpenCli","site","args","stdout","JSON","readInitialSnapshot","path","URL","createAction","config","_deps","xLimit","linkedInLimit","snapshot","freshness","warnings","refresh","key","task","error","message","Error","String","anyLive","Object","value","Date"],"mappings":"AAAA,SAASA,QAAQ,QAAQ,qBAAqB;AAC9C,SAASC,QAAQ,QAAQ,mBAAmB;AAC5C,SAASC,SAAS,QAAQ,YAAY;AACtC,SAASC,eAAe,EAAEC,YAAY,EAAEC,CAAC,QAAQ,uBAAuB;AAUxE,MAAMC,gBAAgBJ,UAAUF;AAChC,MAAMO,MAAMJ,gBAAgB;AAC5B,MAAMK,eAAe;AACrB,MAAMC,iBAAiBJ,EAAE,MAAM,CAAC;IAC5B,QAAQA,EAAE,MAAM,GAAG,GAAG,GAAG,GAAG,CAAC,IAAI,GAAG,CAAC,KAAK,QAAQ,GAAG,QAAQ,CAAC;IAC9D,eAAeA,EAAE,MAAM,GAAG,GAAG,GAAG,GAAG,CAAC,GAAG,GAAG,CAAC,IAAI,QAAQ,GAAG,QAAQ,CAAC;AACvE;AACA,eAAeK,WAAWC,IAAI,EAAEC,IAAI;IAChC,MAAM,EAAEC,MAAM,EAAE,GAAG,MAAMP,cAAc,WAAW;QAC9C;QACAE;QACAG;WACGC;QACH;QACA;QACA;QACA;QACA;QACA;QACA;QACA;KACH,EAAE;QACC,SAAS;QACT,WAAW;IACf;IACA,OAAOE,KAAK,KAAK,CAACD;AACtB;AACA,eAAeE;IACX,MAAMC,OAAO,IAAIC,IAAI,sCAAsC,YAAY,GAAG;IAC1E,OAAOH,KAAK,KAAK,CAAC,MAAMb,SAASe,MAAM;AAC3C;AACA,SAASE,aAAaC,MAAM,EAAEC,KAAK;IAC/B,OAAOhB,aAAa;QAChBe;QACA,QAAQV;QACR,SAAS,OAAO,EAAEY,SAAS,EAAE,EAAEC,gBAAgB,EAAE,EAAE;YAC/C,MAAMC,WAAW,MAAMR;YACvB,MAAMS,YAAY;gBACd,UAAU;gBACV,QAAQ;gBACR,iBAAiB;gBACjB,eAAe;gBACf,mBAAmB;YACvB;YACA,MAAMC,WAAW,EAAE;YACnB,eAAeC,QAAQC,GAAG,EAAEC,IAAI;gBAC5B,IAAI;oBACAL,QAAQ,CAACI,IAAI,GAAG,MAAMC;oBACtBJ,SAAS,CAACG,IAAI,GAAG;gBACrB,EAAE,OAAOE,OAAO;oBACZ,MAAMC,UAAUD,iBAAiBE,QAAQF,MAAM,OAAO,GAAGG,OAAOH;oBAChEJ,SAAS,IAAI,CAAC,GAAGE,IAAI,EAAE,EAAEG,SAAS;oBAClCvB,IAAI,IAAI,CAAC,qCAAqC;wBAC1CoB;wBACA,OAAOG;oBACX;gBACJ;YACJ;YACA,MAAMJ,QAAQ,YAAY,IAAIhB,WAAW,WAAW;oBAC5C;oBACA;iBACH;YACL,MAAMgB,QAAQ,UAAU,IAAIhB,WAAW,WAAW;oBAC1C;oBACA;oBACA;oBACAsB,OAAOX;oBACP;oBACA;iBACH;YACL,MAAMK,QAAQ,mBAAmB,IAAIhB,WAAW,YAAY;oBACpD;oBACA;oBACA;iBACH;YACL,MAAMgB,QAAQ,iBAAiB,IAAIhB,WAAW,YAAY;oBAClD;oBACA;oBACA;oBACA;oBACAsB,OAAOV;iBACV;YACL,MAAMI,QAAQ,qBAAqB,IAAIhB,WAAW,YAAY;oBACtD;oBACA;oBACA;oBACA;oBACAsB,OAAOV;iBACV;YACL,MAAMW,UAAUC,OAAO,MAAM,CAACV,WAAW,IAAI,CAAC,CAACW,QAAQA,AAAU,WAAVA;YACvD,OAAO;gBACH,QAAQ;gBACR,MAAM;oBACF,GAAGZ,QAAQ;oBACX,YAAYU,UAAU,IAAIG,OAAO,WAAW,KAAKb,SAAS,UAAU;oBACpEC;oBACAC;oBACA,MAAMA,SAAS,MAAM,GAAG,IAAI,6FAA6F;gBAC7H;YACJ;QACJ;IACJ;AACJ;SAESP,YAAY"}{"version":3,"sources":["/home/rome/.rome/default/projects/apps/account-growth/src/actions/snapshot/index.ts"],"sourcesContent":["import { execFile } from \"node:child_process\";\nimport { readFile } from \"node:fs/promises\";\nimport { promisify } from \"node:util\";\nimport {\n  createAppLogger,\n  defineAction,\n  z,\n  type Action,\n  type ActionConfig,\n  type AppActionRuntimeDeps,\n} from \"@rome-os/app-runtime\";\n\nconst execFileAsync = promisify(execFile);\nconst log = createAppLogger(\"account-growth:snapshot\");\nconst CDP_ENDPOINT = \"http://127.0.0.1:9223\";\n\nconst snapshotSchema = z.object({\n  xLimit: z.number().int().min(10).max(100).optional().describe(\"Number of recent X posts to read\"),\n  linkedInLimit: z\n    .number()\n    .int()\n    .min(5)\n    .max(50)\n    .optional()\n    .describe(\"Number of recent LinkedIn posts to read\"),\n});\n\nasync function runOpenCli(site: string, args: string[]): Promise<unknown> {\n  const { stdout } = await execFileAsync(\n    \"opencli\",\n    [\n      \"--cdp-endpoint\",\n      CDP_ENDPOINT,\n      site,\n      ...args,\n      \"-f\",\n      \"json\",\n      \"--window\",\n      \"background\",\n      \"--site-session\",\n      \"persistent\",\n      \"--keep-tab\",\n      \"false\",\n    ],\n    { timeout: 120_000, maxBuffer: 8 * 1024 * 1024 },\n  );\n  return JSON.parse(stdout);\n}\n\ninterface SnapshotData {\n  capturedAt: string;\n  xProfile: unknown;\n  xPosts: unknown;\n  linkedInProfile: unknown;\n  linkedInPosts: unknown;\n  linkedInAnalytics: unknown;\n}\n\nasync function readInitialSnapshot(): Promise<SnapshotData> {\n  const path = new URL(\"../../assets/initial-snapshot.json\", import.meta.url);\n  return JSON.parse(await readFile(path, \"utf8\")) as SnapshotData;\n}\n\nexport function createAction(config: ActionConfig, _deps: AppActionRuntimeDeps): Action {\n  return defineAction({\n    config,\n    schema: snapshotSchema,\n    execute: async ({ xLimit = 50, linkedInLimit = 30 }) => {\n      const snapshot = await readInitialSnapshot();\n      const freshness: Record<string, \"live\" | \"baseline\"> = {\n        xProfile: \"baseline\",\n        xPosts: \"baseline\",\n        linkedInProfile: \"baseline\",\n        linkedInPosts: \"baseline\",\n        linkedInAnalytics: \"baseline\",\n      };\n      const warnings: string[] = [];\n\n      async function refresh(key: keyof Omit<SnapshotData, \"capturedAt\">, task: () => Promise<unknown>) {\n        try {\n          snapshot[key] = await task();\n          freshness[key] = \"live\";\n        } catch (error) {\n          const message = error instanceof Error ? error.message : String(error);\n          warnings.push(`${key}: ${message}`);\n          log.warn(\"using baseline snapshot component\", { key, error: message });\n        }\n      }\n\n      await refresh(\"xProfile\", () => runOpenCli(\"twitter\", [\"profile\", \"realYunfanYe\"]));\n      await refresh(\"xPosts\", () =>\n        runOpenCli(\"twitter\", [\n          \"tweets\",\n          \"realYunfanYe\",\n          \"--limit\",\n          String(xLimit),\n          \"--page-delay\",\n          \"1\",\n        ]),\n      );\n      await refresh(\"linkedInProfile\", () =>\n        runOpenCli(\"linkedin\", [\n          \"profile-read\",\n          \"--profile-url\",\n          \"https://www.linkedin.com/in/yunfanye/\",\n        ]),\n      );\n      await refresh(\"linkedInPosts\", () =>\n        runOpenCli(\"linkedin\", [\n          \"posts\",\n          \"--profile-url\",\n          \"https://www.linkedin.com/in/yunfanye/\",\n          \"--limit\",\n          String(linkedInLimit),\n        ]),\n      );\n      await refresh(\"linkedInAnalytics\", () =>\n        runOpenCli(\"linkedin\", [\n          \"post-analytics\",\n          \"--profile-url\",\n          \"https://www.linkedin.com/in/yunfanye/\",\n          \"--limit\",\n          String(linkedInLimit),\n        ]),\n      );\n\n      const anyLive = Object.values(freshness).some((value) => value === \"live\");\n      return {\n        status: \"ok\",\n        data: {\n          ...snapshot,\n          capturedAt: anyLive ? new Date().toISOString() : snapshot.capturedAt,\n          freshness,\n          warnings,\n          note:\n            warnings.length > 0\n              ? \"Some live reads were unavailable or rate-limited; baseline values are explicitly marked.\"\n              : \"All account signals were refreshed live.\",\n        },\n      };\n    },\n  });\n}\n"],"names":["execFile","readFile","promisify","createAppLogger","defineAction","z","execFileAsync","log","CDP_ENDPOINT","snapshotSchema","runOpenCli","site","args","stdout","JSON","readInitialSnapshot","path","URL","createAction","config","_deps","xLimit","linkedInLimit","snapshot","freshness","warnings","refresh","key","task","error","message","Error","String","anyLive","Object","value","Date"],"mappings":";;;;;;;;;AAA8C;AACF;AACN;AAQR;AAE9B,MAAMM,aAAaA,GAAGJ,SAASA,CAACF,QAAQA;AACxC,MAAMO,GAAGA,GAAGJ,eAAeA,CAAC;AAC5B,MAAMK,YAAYA,GAAG;AAErB,MAAMC,cAAcA,GAAGJ,QAAQ,CAAC;IAC9B,QAAQA,QAAQ,GAAG,GAAG,GAAG,GAAG,CAAC,IAAI,GAAG,CAAC,KAAK,QAAQ,GAAG,QAAQ,CAAC;IAC9D,eAA