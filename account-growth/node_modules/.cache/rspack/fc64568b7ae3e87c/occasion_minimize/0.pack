che: \"AI agents and agent-native software, with founder and investor takes grounded in building Rome OS\",\n          audience: \"AI builders, founders, engineers, investors, and early adopters\",\n          voice: \"Practical and conversational\",\n          cadence: \"5 original X posts per week\",\n          boundary: \"Draft only ‚Äî never publish\",\n          xAccount: \"@realYunfanYe\",\n          linkedIn: \"linkedin.com/in/yunfanye\",\n        },\n        plans,\n      });\n    }\n\n    return json(\n      {\n        error: \"not_found\",\n        appId: this.ctx.app.id,\n        message: `Unknown Account Growth API route: /${route}`,\n      },\n      { status: 404 },\n    );\n  }\n}\n\nexport function createApiHandler(ctx: RomeAppContext): RomeAppApiHandler {\n  return new AccountGrowthApiHandler(ctx);\n}\n"],"names":["createPlansRepository","json","data","init","Response","AccountGrowthApiHandler","ctx","request","route","repository","plans","createApiHandler"],"mappings":";;;AACoE;AAEpE,SAASC,IAAIA,CAACC,IAAa,EAAEC,IAAmB;IAC9C,OAAOC,SAAS,IAAI,CAACF,MAAMC;AAC7B;AAEA,MAAME,uBAAuBA;;IAC3B,YAA6BC,GAAmB,CAAE;aAArBA,MAAAA;IAAsB;IAEnD,MAAM,OAAOC,OAA0B,EAAqB;QAC1D,MAAMC,QAAQD,QAAQ,IAAI,CAAC,IAAI,CAAC;QAEhC,IAAIA,QAAQ,MAAM,CAAC,IAAI,KAAK,YAAY;YACtC,OAAON,IAAIA,CAAC;gBAAE,OAAO;YAAY,GAAG;gBAAE,QAAQ;YAAI;QACpD;QAEA,IAAIM,QAAQ,MAAM,KAAK,SAASC,UAAU,SAAS;YACjD,MAAMC,aAAaT,qBAAqBA,CAAC,IAAI,CAAC,GAAG,CAAC,EAAE;YACpD,MAAMU,QAAQ,MAAMD,WAAW,IAAI,CAAC;YACpC,OAAOR,IAAIA,CAAC;gBACV,OAAO,IAAI,CAAC,GAAG,CAAC,GAAG,CAAC,EAAE;gBACtB,SAAS,IAAI,CAAC,GAAG,CAAC,GAAG,CAAC,OAAO;gBAC7B,QAAQ;oBACN,OAAO;oBACP,UAAU;oBACV,OAAO;oBACP,SAAS;oBACT,UAAU;oBACV,UAAU;oBACV,UAAU;gBACZ;gBACAS;YACF;QACF;QAEA,OAAOT,IAAIA,CACT;YACE,OAAO;YACP,OAAO,IAAI,CAAC,GAAG,CAAC,GAAG,CAAC,EAAE;YACtB,SAAS,CAAC,mCAAmC,EAAEO,OAAO;QACxD,GACA;YAAE,QAAQ;QAAI;IAElB;AACF;AAEO,SAASG,gBAAgBA,CAACL,GAAmB;IAClD,OAAO,IAAID,uBAAuBA,CAACC;AACrC"}␀␀␀Ç␀␀`‚ˇˇå␀␀␀⁄ËˇˇΩ-␀␀ﬁËˇˇ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ë.␀␀CÙˇˇ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀